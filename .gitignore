# Model weights and upstream checkouts stay on each deployment machine.
/models/
**/models/
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.bin
*.gguf
*.tflite
/Qwen3-VL/
/references/
/third_party/

# Runtime data, knowledge files and private configuration are not public code.
/data/
/knowledge/
/http/.tools/
.env
.env.*
!.env.example
.web.env
*.pem
*.key
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.lock
*.log
*.wav
*.mp3
*.webm
*.mp4
*.faiss
*.npy
*.npz

# Caches, editors and generated source packages.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.cache/
.venv/
venv/
node_modules/
.vscode/
.DS_Store
__MACOSX/
._*
/exports/
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.bundle

# The Markdown proposal is the source; its old Word export is not maintained.
/docs/*.docx
